# Generated by matugen from the wallpaper (template: ~/.config/matugen/templates/mako)
font=Noto Sans 11
width=360
height=160
margin=12
padding=14
border-size=1
border-radius=14
icons=1
max-icon-size=48
default-timeout=6000
max-visible=4
layer=overlay
anchor=top-right
background-color=#{{colors.surface.default.hex_stripped}}ee
text-color=#{{colors.on_surface.default.hex_stripped}}
border-color=#{{colors.primary.default.hex_stripped}}55
progress-color=over #{{colors.primary.default.hex_stripped}}44

[urgency=critical]
border-color=#{{colors.error.default.hex_stripped}}
default-timeout=0

# volume/brightness OSD (osd.sh): small, centered at the top, no timeout stacking
[app-name=osd]
anchor=top-center
width=260
height=70
margin=12,0,0,0
default-timeout=1200
group-by=app-name
