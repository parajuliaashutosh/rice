# Fallback notification style; matugen rewrites this whole file from the wallpaper
# (template: ~/.config/matugen/templates/mako).
font=Noto Sans 11
width=360
height=160
margin=12
padding=14
border-size=1
border-radius=14
icons=1
max-icon-size=48
default-timeout=6000
max-visible=4
layer=overlay
anchor=top-right
background-color=#151515ee
text-color=#e6e1e5
border-color=#7aa2f755
progress-color=over #7aa2f744

[urgency=critical]
border-color=#f7768e
default-timeout=0

# volume/brightness OSD (osd.sh): small, centered at the bottom, no timeout stacking
[app-name=osd]
anchor=bottom-center
width=260
height=70
margin=0,0,80,0
default-timeout=1200
group-by=app-name
