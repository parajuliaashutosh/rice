    readonly property var today: toBs(DateTime.clock.date)
    readonly property string text: today ? `${toNepaliDigits(today.day)} ${monthsNp[today.month - 1]} ${toNepaliDigits(today.year)}` : ""

    function toNepaliDigits(n) {
        return String(n).replace(/[0-9]/g, d => "०१२३४५६७८९"[d]);
    }

    function toBs(date) {
        let days = Math.round((Date.UTC(date.getFullYear(), date.getMonth(), date.getDate()) - Date.UTC(1976, 3, 13)) / 86400000);
        if (days < 0) return null;
        let i = 0, month = 1, day = 1;
        while (days > 0) {
            const row = daysInMonths[i];
            if (!row) return null;
            day++;
            if (day > row[month]) {
                day = 1;
                month++;
                if (month > 12) {
                    month = 1;
                    i++;
                }
            }
            days--;
        }
        return daysInMonths[i] ? { year: daysInMonths[i][0], month: month, day: day } : null;
    }
